# Exos AI 環境変数テンプレート（要件01 §3）
# コピーして .env.local を作成する。実キーはコミットしない（.env* は gitignore 済み）。
# 検証は src/lib/env-schema.ts が起動時に実行する。必須は APP_ENV により変わる。

# ── §3.1 アプリ共通 ──────────────────────────────────────────
APP_BASE_URL=http://127.0.0.1:3000          # OAuth callback・メールリンク・Stripe return URLの基準（末尾スラッシュなし）。ローカルは127.0.0.1（X OAuthはlocalhost不可）
APP_ENV=development                          # development / preview / production
CRON_SECRET=                                 # launchd/Vercel Cron・内部job dispatch(POST /api/jobs/run)のBearer認証。全環境必須・未設定は起動失敗
APP_ENCRYPTION_KEY=                          # AES-256-GCM暗号鍵（32 bytes相当）
X_POSTING_MODE=dry_run                       # dry_run / live。dev・previewはdry_run必須、liveはproductionのみ
FEATURE_QUOTE_POST_ENABLED=false             # P-5引用ポストの有効化。未設定はfalse
X_DAILY_POST_LIMIT=50                        # 1Xアカウント/日の投稿上限（既定50）
X_COST_CONTENT_CREATE_USD=0.015              # URLなし投稿作成の原価集計単価（preview/prod必須。Console値優先）
X_COST_CONTENT_CREATE_WITH_URL_USD=0.200     # URL付き投稿作成の原価集計単価（preview/prod必須）
X_COST_INTERACTION_DELETE_USD=0.010          # ロールバック削除の原価集計単価（preview/prod必須）
X_COST_POST_READ_USD=0.005                   # ポスト読取1件の単価（応答件数で乗算。実績収集・学習・改善提案が使う）
X_COST_USER_READ_USD=0.010                   # ユーザー読取1件の単価（フォロワー数取得等）

# ── §3.2 Supabase ───────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=                    # Supabase client URL（Public）
NEXT_PUBLIC_SUPABASE_ANON_KEY=               # ブラウザ用anon key（Public）
SUPABASE_SERVICE_ROLE_KEY=                   # cron/webhook/管理処理用（Server only・使用箇所を限定）
DATABASE_URL=                                # worker/cronの直接接続（Supavisor transaction mode pooler・Server only）
SUPABASE_STORAGE_BUCKET_IMAGES=generated-images  # 生成画像bucket（既定 generated-images）

# ── §3.3 Stripe ─────────────────────────────────────────────
STRIPE_SECRET_KEY=                           # Checkout/Portal/Webhook API（Server only）
STRIPE_WEBHOOK_SECRET=                       # Webhook署名検証（環境ごとに別値）
STRIPE_PORTAL_CONFIGURATION_ID=              # Customer Portal configuration（preview/prod必須）
STRIPE_PRICE_STANDARD_MONTHLY=               # 通常プラン価格ID（500円/月）
STRIPE_PRICE_MD_MONTHLY=                     # mdプラン価格ID（1,000円/月）
STRIPE_PRICE_PREMIUM_MONTHLY=                # プレミアム価格ID（2,980円/月）

# ── §3.4 X API ──────────────────────────────────────────────
X_MANAGED_CLIENT_ID=                         # プレミアム用運営Developer App（preview/prod必須。BYOKはユーザー登録値）
X_MANAGED_CLIENT_SECRET=                     # 運営App secret（confidential clientの場合のみ・Server only）
X_OAUTH_REDIRECT_PATH=/api/x/oauth/callback  # OAuth callback path（既定）

# ── §3.5 AI・画像 ───────────────────────────────────────────
ANTHROPIC_API_KEY=                           # 共通ニュース取得(NEWS_TEXT_PROVIDER=anthropic時)＋プレミアム文章生成。preview/prod必須
OPENAI_API_KEY=                              # プレミアム文章/画像生成候補（BYOKはユーザー登録値）
GEMINI_API_KEY=                              # プレミアム文章/画像生成候補（BYOKはユーザー登録値）
PREMIUM_TEXT_PROVIDER=anthropic              # プレミアム文章/分析の既定provider（anthropic/openai/google）
NEWS_TEXT_PROVIDER=anthropic                 # 共通ニュース取得provider（preview/prod必須・無効時に別providerへ自動切替しない）
ANTHROPIC_TEXT_MODEL=                         # Claude文章モデル（実装時に公式仕様確認）
OPENAI_TEXT_MODEL=                            # OpenAI文章モデル
OPENAI_IMAGE_MODEL=                           # OpenAI画像モデル
GEMINI_TEXT_MODEL=                            # Gemini文章モデル
GEMINI_IMAGE_MODEL=                           # Gemini画像モデル

# ── §3.6 メール・監視 ───────────────────────────────────────
SMTP_HOST=smtp.gmail.com                      # Gmail SMTP host（preview/prod必須）
SMTP_PORT=587                                 # STARTTLS
SMTP_USER=                                    # Gmail SMTP user
SMTP_APP_PASSWORD=                            # Google 2段階認証で発行するApp Password（Server only）
EMAIL_FROM=                                   # Fromアドレス（例 Exos AI <ops@example.com>）
EMAIL_REPLY_TO=                               # Reply-Toアドレス
SUPPORT_EMAIL=                                # 問い合わせ先（全環境必須・SC-11と法務ページで使用）
NEXT_PUBLIC_TURNSTILE_SITE_KEY=               # Turnstile site key（preview/prod必須）。local常時成功: 1x00000000000000000000AA
TURNSTILE_SECRET_KEY=                         # Turnstile secret（Server only）。local常時成功: 1x0000000000000000000000000000000AA（Supabase CLI用root .envにも設定）
SENTRY_DSN=                                   # サーバー例外収集（preview/prod必須・Server only）
NEXT_PUBLIC_SENTRY_DSN=                       # ブラウザ例外収集（Public）

# --- 手元からデプロイ先を操作するための値（アプリ本体は使わない。秘密ではないURLと環境ごとの鍵） ---
STAGING_BASE_URL=                             # staging のURL。release:staging / doctor / smoke:live が参照（未設定だとゲートが止まる）
PRODUCTION_BASE_URL=                          # production のURL。同上
STAGING_CRON_SECRET=                          # staging の CRON_SECRET。`doctor -- --base <staging>` が使う（環境ごとに別の鍵・T-M7-47）
PRODUCTION_CRON_SECRET=                       # production の CRON_SECRET。同上
# `stripe:portal:setup -- --target staging|production` が使う（T-M8-35 / T-M8-50）。
# **環境ごとに別のStripeアカウント**なので、鍵・price・構成IDの5つすべてが手元とは違う値になる
# （2026-08-04 実測。手元の鍵ではstgの Portal Configuration が一覧に出てこない）。
# 足りない値はコマンドが5件まとめて教えるので、言われたものをVercelの Preview / Production からコピーする。
STAGING_STRIPE_SECRET_KEY=
STAGING_STRIPE_PRICE_STANDARD_MONTHLY=
STAGING_STRIPE_PRICE_MD_MONTHLY=
STAGING_STRIPE_PRICE_PREMIUM_MONTHLY=
STAGING_STRIPE_PORTAL_CONFIGURATION_ID=
PRODUCTION_STRIPE_SECRET_KEY=
PRODUCTION_STRIPE_PRICE_STANDARD_MONTHLY=
PRODUCTION_STRIPE_PRICE_MD_MONTHLY=
PRODUCTION_STRIPE_PRICE_PREMIUM_MONTHLY=
PRODUCTION_STRIPE_PORTAL_CONFIGURATION_ID=
