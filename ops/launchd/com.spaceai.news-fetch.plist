<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Exos AI news_fetch（要件04 §6・運用メモ §2）。RSS巡回・20分おき（T-M8-380）。
     __INSTALL_DIR__ を実配置先へ setup で置換する（既定 /opt/space-ai）。秘密値は含めない。 -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.spaceai.news-fetch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__INSTALL_DIR__/ops/launchd/cron-call.sh</string>
    <string>news-fetch</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>APP_BASE_URL</key>
    <string>http://127.0.0.1:3000</string>
    <key>CRON_SECRET_KEYCHAIN_SERVICE</key>
    <string>space-ai-cron-secret</string>
  </dict>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Minute</key><integer>0</integer></dict>
    <dict><key>Minute</key><integer>20</integer></dict>
    <dict><key>Minute</key><integer>40</integer></dict>
  </array>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>__INSTALL_DIR__/logs/news-fetch.log</string>
  <key>StandardErrorPath</key>
  <string>__INSTALL_DIR__/logs/news-fetch.log</string>
</dict>
</plist>
