# OS
.DS_Store

# 環境変数・秘密情報
.env
.env.*
!.env.example

# DB論理バックアップ（暗号化dump・平文とも絶対にコミットしない・T-M6-19）
backups/
*.sql.enc

# 依存・ビルド成果物
node_modules/
# dist/ には npm run dev-kit の出力（dist/claude-dev-kit/）も入る
dist/
build/
.next/
out/
coverage/
*.tsbuildinfo
next-env.d.ts
.vercel
*.pem

# ログ・一時ファイル
*.log
tmp/

# Claude Code（個人ローカル設定）
.claude/settings.local.json

# Playwright CLI（一時スナップショット・セッション）
.playwright-cli/

# Playwright E2E（実行結果・レポート・trace）
test-results/
playwright-report/

# IDE
.idea/
.vscode/

# UIリデザインの作業用スクリーンショット（コミットしない）
_design_shots/
