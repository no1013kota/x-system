{
  "name": "space-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "stripe:portal:setup": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/setup-stripe-portal.mjs",
    "db:backup": "bash scripts/db-backup.sh",
    "db:restore": "bash scripts/db-restore.sh",
    "db:clean-test-data": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/clean-test-data.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/@playwright/test/cli.js test",
    "audit:check": "node scripts/audit-check.mjs",
    "release:check": "npm run typecheck && npm run lint && npm run audit:check && npm run test:db && npm run build && npm run test:e2e",
    "test:db": "REQUIRE_DB=1 vitest run",
    "check:providers": "PROVIDER_CHECK=1 vitest run src/lib/ai/provider-contract.live.test.ts",
    "check:turnstile": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-turnstile.mjs",
    "smoke:live": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/smoke-live.mjs",
    "doctor": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/doctor.mjs",
    "release:staging": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/release.mjs staging",
    "release:production": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/release.mjs production",
    "icons:generate": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@base-ui/react": "^1.6.0",
    "@google/genai": "^2.12.0",
    "@sentry/nextjs": "^10.66.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.110.8",
    "@types/nodemailer": "^8.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "next": "16.2.12",
    "nodemailer": "^9.0.3",
    "openai": "^6.48.0",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "twitter-text": "^3.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@material-symbols/svg-400": "^0.45.10",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/twitter-text": "^3.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "shadcn": "^4.13.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "postcss": "^8.5.20"
  }
}
